{
  "name": "agentboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent coordination and operations console for a simulated People-operations organization, on Cloudflare Workers.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev",
    "types": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "types:check": "wrangler types --strict-vars=false --env-file .dev.vars.example --check",
    "typecheck": "tsc -b",
    "test": "vitest run --project worker --project worker-ws --project worker-access --project node",
    "build": "vite build",
    "build:prod": "CLOUDFLARE_ENV=production vite build",
    "preview": "vite preview",
    "synth": "node scripts/generate-synthetic.ts",
    "synth:check": "node scripts/generate-synthetic.ts --check",
    "db:migrate:local": "wrangler d1 migrations apply agentboard --local && wrangler d1 migrations apply agentboard-people --local",
    "db:seed:local": "wrangler d1 execute agentboard --local --file seed/console.sql && wrangler d1 execute agentboard-people --local --file seed/people.sql",
    "dev:keys": "node scripts/dev-keys.ts",
    "dev:token": "node scripts/dev-token.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.27.0",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
